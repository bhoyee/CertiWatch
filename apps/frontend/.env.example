NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Both optional - the Google Drive folder picker on /sources falls back to a manual "paste a
# folder ID" input when these are blank. Client ID is the same OAuth client as GoogleOAuth:ClientId
# on the API; the API key is a separate Google Cloud "API key" restricted to the Picker API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
