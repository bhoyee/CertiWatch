# Normalize line endings to LF in the repository regardless of platform, so `git status`/`git diff`
# don't show phantom "modified" files on Windows (CRLF vs LF) - this was blocking updates locally.
# Shell scripts in particular *must* be LF: a CRLF shebang line breaks them inside Linux containers.
* text=auto eol=lf

# Binary formats - never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
