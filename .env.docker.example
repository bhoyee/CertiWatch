# API / Billing
Stripe__SecretKey=sk_test_xxx
Stripe__WebhookSecret=whsec_xxx
Stripe__Plans__0__PriceId=price_starter
Stripe__Plans__1__PriceId=price_growth
Stripe__Plans__2__PriceId=price_pro

# Frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email (SMTP / Resend) - leave SmtpHost blank to skip real sending entirely: magic links and
# other emails get logged to the api container's console instead (`docker compose logs -f api`,
# look for "[Email] (debug) Body:" and copy the /magic?token=... link out of it). Fill these in
# with real credentials only once you have a real SMTP/Resend account.
Email__FromAddress=hello@salisu.dev
Email__FromName=CertiWatch
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__SmtpEncryption=starttls

# Worker device credentials - obtained by enrolling a device (see README "Docker quickstart"),
# not hardcoded. Each device gets its own token; never reuse one across environments.
WORKER__DeviceId=
WORKER__DeviceToken=

# DeepSeek (primary extraction; optional)
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
